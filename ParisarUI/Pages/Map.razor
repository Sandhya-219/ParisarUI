@page "/map"
@using LeafletForBlazor
@using ParisarUI.DTO

<PageTitle>Map</PageTitle>

<RealTimeMap Height="460px"
             Width="100%"
             Parameters="parameters"
             OnAfterMapLoaded="OnAfterMapLoaded">
</RealTimeMap>

@code {

    [Parameter] public List<Location> Locations { get; set; } = new();
    [Parameter] public bool IsPm10 { get; set; }

    private RealTimeMap mapRef;

    RealTimeMap.LoadParameters parameters = new()
    {
        location = new RealTimeMap.Location()
        {
            latitude = 18.5204,
            longitude = 73.8567
        },
        zoomLevel = 12
    };

    // 🔥 Runs once
    public async Task OnAfterMapLoaded(RealTimeMap.MapEventArgs args)
    {
        mapRef = args.sender as RealTimeMap;

        mapRef.Geometric.Points.Appearance().pattern = new RealTimeMap.PointTooltip()
        {
            content = "${value}"
        };

        await LoadMarkers();
    }

    // 🔥 Runs on toggle change
    protected override async Task OnParametersSetAsync()
    {
        if (mapRef != null)
        {
            await LoadMarkers();
        }
    }

    // 🔥 Reload markers (no clear support → re-upload only once safely)
    private async Task LoadMarkers()
    {
        if (Locations == null || !Locations.Any()) return;

        var points = Locations.Select(loc =>
        {
            var pmValue = GetPMValue(loc);

            return new RealTimeMap.StreamPoint
            {
                guid = Guid.NewGuid(),
                latitude = loc.Latitude,
                longitude = loc.Longitude,
                value = $"<b>{loc.Name}</b><br/>PM: {pmValue}"
            };
        }).ToList();

        await mapRef.Geometric.Points.upload(points);
    }

    // 🔥 TEMP PM values
    private double GetPMValue(Location loc)
    {
        return IsPm10
            ? new Random().Next(50, 300)
            : new Random().Next(20, 150);
    }
}