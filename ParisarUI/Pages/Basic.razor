@page "/basic"
@using ApexCharts
@using ParisarUI.Dashboard

<div class="p-2 bg-gray-100 h-screen overflow-hidden">

    <h3 class="text-base font-semibold mb-1">Graph</h3>

    <!-- TOGGLE -->
    <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-medium text-black">PM2.5</span>

        <div class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" class="sr-only peer" @bind="isPm10" />
            <div class="w-10 h-5 bg-gray-300 rounded-full
                after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                after:bg-white after:rounded-full after:h-4 after:w-4
                after:transition-all peer-checked:after:translate-x-5">
            </div>
        </div>

        <span class="text-xs font-medium @(isPm10 ? "text-blue-600" : "text-gray-400")">
            PM10
        </span>
    </div>

    <!-- FILTERS -->
    <div class="flex gap-2 flex-wrap mb-2">
        <select @bind="selectedOption"
                class="border border-gray-400 p-1 rounded w-40 bg-gray-100 text-xs">
            <option value="">SELECT</option>
            <option value="1">Alandi</option>
            <option value="2">Bhosari</option>
            <option value="3">Bhumkar Nagar</option>
            <option value="4">Hadapsar</option>
            <option value="5">Dhankawadi</option>
            <option value="6">MIT-Kothrud</option>
            <option value="7">Mhada Colony</option>
            <option value="8">Transport Nagar-Nigdi</option>
            <option value="9">Panchawati-Pashan</option>
        </select>

        <InputDate @bind-Value="selectedDate"
                   class="border bg-gray-100 border-gray-400 p-1 rounded w-40 text-xs" />

        <button class="bg-blue-500 text-white px-3 py-1 rounded text-xs">
            Update
        </button>
    </div>

    <!-- CHARTS -->
    <div class="grid grid-cols-2 gap-2 h-[65vh]">

        <!-- BAR CHART -->
        <div class="bg-white p-2 rounded-xl shadow">

            <p class="text-center text-xs mb-1">
                Top 3 wards showing the lowest to highest levels of PM2.5
            </p>

            <div class="w-full h-[190px]">

                <ApexChart TItem="ChartData" Options="barOptions">

                    <ApexCharts.ApexPointSeries TItem="ChartData"
                                                Items="barData"
                                                SeriesType="SeriesType.Bar"
                                                XValue="@(e => e.Area)"
                                                YValue="@(e => e.Value)" />

                </ApexChart>

            </div>
        </div>

        <!-- LINE CHART -->
        <div class="bg-white p-2 rounded-xl shadow">

            <h1 class="text-xs font-semibold mb-1">
                PM2.5 Trends
            </h1>

            <ApexChart TItem="DataPoint" Height="260">
                <!-- 🔥 Increased -->

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="Data2024"
                                            Name="2024"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="Data2025"
                                            Name="2025"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="Data2026"
                                            Name="2026"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />

            </ApexChart>

        </div>

    </div>

</div>

@code {

    private bool isPm10 = false;
    private string selectedOption = "";
    private DateTime selectedDate = new(2024, 1, 1);

    private List<ChartData> barData = [];
    private ApexChartOptions<ChartData> barOptions = new();

    protected override void OnInitialized()
    {
        barData =
        [
            new() { Area = "Panchawati-Pashan(Best_1)", Value = 31.09m },
            new() { Area = "Bhosari(Best_2)", Value = 33.4m },
            new() { Area = "Transport Nagar-Nigdi(Best_3)", Value = 35.36m },
            new() { Area = "Hadapsar(Worst_10)", Value = 57.56m },
            new() { Area = "Bhumkar Nagar(Worst_11)", Value = 58.77m },
            new() { Area = "MIT-Kothrud(Worst_12)", Value = 61.62m }
        ];

        barOptions = new()
        {
            Chart = new() { Toolbar = new() { Show = false } },

            PlotOptions = new()
            {
                Bar = new()
                {
                    ColumnWidth = "45%",
                    Distributed = true
                }
            },

            Xaxis = new()
            {
                Labels = new()
                {
                    Rotate = -45,
                    Style = new() { FontSize = "9px" }
                }
            },

            // 🔥 VALUE BASED COLORS
            Colors = barData.Select(d =>
                d.Value < 40 ? "#22C55E" :     // Green (good)
                d.Value < 50 ? "#EAB308" :     // Yellow (moderate)
                "#EF4444"                     // Red (bad)
            ).ToList(),

            Yaxis =
            [
                new() { Title = new() { Text = "Average PM2.5" } }
            ]
        };
    }

    public class ChartData
    {
        public string Area { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    public class DataPoint
    {
        public string Month { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    List<DataPoint> Data2024 =
    [
        new() { Month = "Jan", Value = 62.8m },
        new() { Month = "Feb", Value = 60.6m },
        new() { Month = "Mar", Value = 51.26m },
        new() { Month = "Apr", Value = 45.44m },
        new() { Month = "May", Value = 38.67m },
        new() { Month = "Jun", Value = 22.72m },
        new() { Month = "Jul", Value = 17.51m },
        new() { Month = "Aug", Value = 22.75m },
        new() { Month = "Sep", Value = 20.79m },
        new() { Month = "Oct", Value = 33.82m },
        new() { Month = "Nov", Value = 57.99m },
        new() { Month = "Dec", Value = 51.29m }
    ];

    List<DataPoint> Data2025 =
    [
        new() { Month = "Jan", Value = 60.55m },
        new() { Month = "Feb", Value = 56.2m },
        new() { Month = "Mar", Value = 49.66m },
        new() { Month = "Apr", Value = 38.87m },
        new() { Month = "May", Value = 29.56m },
        new() { Month = "Jun", Value = 27.65m },
        new() { Month = "Jul", Value = 25.12m },
        new() { Month = "Aug", Value = 24.21m },
        new() { Month = "Sep", Value = 26.03m },
        new() { Month = "Oct", Value = 39.7m },
        new() { Month = "Nov", Value = 60.27m },
        new() { Month = "Dec", Value = 90.35m }
    ];

    List<DataPoint> Data2026 =
    [
        new() { Month = "Jan", Value = 73.94m },
        new() { Month = "Feb", Value = 71.2m },
        new() { Month = "Mar", Value = 47.23m }
    ];
}