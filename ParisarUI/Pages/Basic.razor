@page "/basic"
@using ApexCharts
@using ParisarUI.Dashboard

<h3 class="text-dark">Graph</h3>

<div class="flex items-center gap-3">

    <!-- Left Text -->
    <span class="text-sm font-medium @(isPm10 ? "text-black" : "text-black")">
        PM2.5
    </span>

    <!-- Toggle -->
    <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" @bind="isPm10" />

        <div class="w-12 h-6 bg-gray-300 rounded-full transition
            peer-checked:bg-blue-500
            after:content-[''] after:absolute after:top-[2px] after:left-[2px]
            after:bg-white after:border after:rounded-full
            after:h-5 after:w-5 after:transition-all
            peer-checked:after:translate-x-6">
        </div>
    </label>

    <!-- Right Text -->
    <span class="text-sm font-medium @(isPm10 ? "text-blue-600" : "text-gray-400")">
        PM10
    </span>

</div>

<div class="mb-4">
    <label class="block mb-1 font-medium"></label>

    <select @bind="selectedOption"
            class="border border-gray-500 p-2 rounded w-56 bg-gray-100">
        
        <option value="">SELECT</option>
        <option value="1">Alandi</option>
        <option value="2">Bhosari</option>
        <option value="3">Bhumkar Nagar</option>
        <option value="4">Hadapsar</option>
        <option value="5">Dhankawadi</option>
        <option value="6">MIT-Kothrud</option>
        <option value="7">Mhada Colony</option>
        <option value="8">Transport Nagar-Nigdi</option>
        <option value="9">Panchawati-Pashan</option>
        <option value="10">Savta Mali Nagar</option>
        <option value="11">Revenue Colony-Shivajinagar</option>

    </select>
</div>


<div class="mb-4">
    <label class="block mb-1 font-medium"></label>

    <InputDate @bind-Value="selectedDate"
               class="border bg-gray-100 border-gray-500 p-2 rounded w-56 focus:outline-none focus:ring-2 focus:ring-blue-400" />
</div>
<p>to</p>
<div class="mb-4">
    <label class="block mb-1 font-medium"></label>

    <InputDate @bind-Value="dateTime"
               class="border bg-gray-100 border-gray-500 p-2 rounded w-56 focus:outline-none focus:ring-2 focus:ring-blue-400" />
</div>

<button class="bg-blue-500 text-white px-5 py-2 rounded">Update</button>

<div style="display: flex; justify-content: flex-end;">
    <div style="width: 600px; height: 350px;">
        <ApexChart TItem="Order" Title="Basic Sample" Height="300">

    <ApexCharts.ApexPointSeries TItem="Order"
                                Items="orders"
                                SeriesType="@SeriesType.Area"
                                Name="Gross Value"
                                XValue="@(e => e.Country)"
                                YAggregate="@(e => e.Sum(x => x.GrossValue))"
                                OrderByDescending="e => e.Y" />

    <ApexCharts.ApexPointSeries TItem="Order"
                                Items="orders"
                                SeriesType="@SeriesType.Area"
                                Name="Net Value"
                                XValue="@(e => e.Country)"
                                YAggregate="@(e => e.Sum(x => x.NetValue))"
                                OrderByDescending="e => e.Y" />

    </ApexChart>
    </div>
</div>

@code {
    private List<Order> orders = SampleData.GetOrders();

    private bool isPm10 = false;
    private string selectedOption = ""; // default = SELECT

    private DateTime selectedDate = new DateTime(2024, 1, 1);
    private DateTime dateTime = DateTime.Today;
    
}