@page "/dashboard"
@page "/"
@using ApexCharts
@using ParisarUI.DTO
@using ParisarUI.Dashboard
@using ParisarUI.Pages.Shared
@using ParisarUI.Pages
@inject HttpClient Http

<div class="bg-[oklch(94.3%_0.029_294.588)] min-h-screen p-6">

    <!-- 🔷 FILTER SECTION -->
    <div class="bg-white/70 backdrop-blur-md p-4 rounded-2xl border border-white/40 shadow-sm mb-4 hover:shadow-md transition">
        <h2 class="text-sm font-semibold mb-3 text-gray-700">Filters</h2>

        <div class="flex flex-wrap gap-3 items-center">

            <select @bind="selectedOption" @bind:after="LoadStats"
                    class="border border-gray-200 bg-white/80 p-2 rounded-lg w-48 text-xs shadow-sm focus:ring-2 focus:ring-purple-300 outline-none">
                @if (locations != null)
                {
                    @foreach(var location in locations)
                    {
                        <option value="@(location.Id)"> @(location.Name) </option>
                    }
                }
            </select>

            <InputDate @bind-Value="selectedDate"
                       class="border border-gray-200 bg-white/80 p-2 rounded-lg text-xs shadow-sm focus:ring-2 focus:ring-purple-300 outline-none" />

            <span class="text-xs text-gray-500">to</span>

            <InputDate @bind-Value="DateToday"
                       class="border border-gray-200 bg-white/80 p-2 rounded-lg text-xs shadow-sm focus:ring-2 focus:ring-purple-300 outline-none" />

            <button class="bg-gradient-to-r from-purple-400 to-pink-400 text-white px-4 py-2 rounded-lg text-xs shadow hover:scale-105 transition">
                Update
            </button>
        </div>
    </div>

    <!-- 🔷 LOADER -->
    <Loader Visible="@isLoading"
            Text="Loading Air Quality Data..."
            Size="md" />

    <!--Select Location Name-->
    @if (!string.IsNullOrEmpty(selectedLocationName)) 
    {
        <div class="mb-3">
            <span class="px-3 py-1 text-xs rounded-full bg-[oklch(93.6%_0.032_17.717)] text-purple-700 font-medium shadow-sm">
                📍 @selectedLocationName
            </span>
        </div>
    }

    <!-- 🔷 STATS -->
    @if (stats != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            
            <div class="bg-white/70 backdrop-blur-md bg-[oklch(97.9%_0.021_166.113)] p-4 rounded-2xl border border-white/40 shadow-sm text-center hover:-translate-y-1 hover:shadow-md transition">
                <p class="text-xs text-gray-500">Total Days</p>
                <h3 class="text-xl font-bold text-indigo-500">@stats.TotalDays</h3>
            </div>
            
            <div class="bg-white/70 backdrop-blur-md bg-[oklch(95.5%_0.015_12.422)] p-4 rounded-2xl border border-white/40 shadow-sm text-center hover:-translate-y-1 hover:shadow-md transition">
                <p class="text-xs text-gray-500">Data Available</p>
                <h3 class="text-xl font-bold text-emerald-500">
                    @stats.DataAvailableDays
                </h3>
                <p class="text-[10px] text-gray-400">
                    @((stats.TotalDays == 0) ? 0 : (stats.DataAvailableDays * 100) / stats.TotalDays)%
                </p>
            </div>
            
            <div class="bg-white/70 backdrop-blur-md bg-[oklch(95.1%_0.026_236.824)] p-4 rounded-2xl border border-white/40 shadow-sm text-center hover:-translate-y-1 hover:shadow-md transition">
                <p class="text-xs text-gray-500">Rank</p>
                <h3 class="text-xl font-bold text-violet-500">
                    @stats.Rank / @stats.TotalLocations
                </h3>
            </div>
            
            <div class="bg-white/70 backdrop-blur-md bg-[oklch(97.7%_0.026_102.212)] p-4 rounded-2xl border border-white/40 shadow-sm text-center hover:-translate-y-1 hover:shadow-md transition">
                <p class="text-xs text-gray-500">Exceed Days</p>
                <h3 class="text-xl font-bold text-rose-400">
                    @stats.ExceedDays
                </h3>
                <p class="text-[10px] text-gray-400">@stats.ExceedPercent%</p>
            </div>

        </div>
    }

    <!-- 🔷 CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

        <div class="bg-white/70 backdrop-blur-md p-4 rounded-2xl border border-white/40 shadow-sm hover:shadow-md transition">
            <h2 class="text-sm font-semibold mb-2 text-gray-600 tracking-wide">
                Best vs Worst Areas (@(isPm10 ? "PM10" : "PM2.5"))
            </h2>

            <ApexChart TItem="ChartData" Options="barOptions" Height="250" @key="chartKey">
                <ApexCharts.ApexPointSeries TItem="ChartData"
                                            Items="(isPm10 ? barDataPM10 : barDataPM25)"
                                            SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.Area)"
                                            YValue="@(e => e.Value)" />
            </ApexChart>
        </div>

        <div class="bg-white/70 backdrop-blur-md p-4 rounded-2xl border border-white/40 shadow-sm hover:shadow-md transition">
            <h2 class="text-sm font-semibold mb-2 text-gray-600 tracking-wide">
                Yearly Trends (@(isPm10 ? "PM10" : "PM2.5"))
            </h2>

            <ApexChart TItem="DataPoint" Height="250" @key="chartKey">

                @foreach (var year in (isPm10 ? YearlyPM10.Keys : YearlyPM25.Keys))
                {
                    <ApexCharts.ApexPointSeries TItem="DataPoint"
                                                Items="@(isPm10 ? YearlyPM10[year] : YearlyPM25[year])"
                                                Name="@year.ToString()"
                                                SeriesType="SeriesType.Line"
                                                XValue="e => e.Month"
                                                YValue="e => e.Value" />
                }

            </ApexChart>
        </div>

    </div>

    <!--Map-->
    <div class="bg-white/70 backdrop-blur-md p-4 rounded-2xl border border-white/40 shadow-sm mt-4 hover:shadow-md transition">
        <div class="mt-4 h-[450px] rounded-xl overflow-hidden border border-white/30 shadow-inner">
            @if (locations != null)
            {
                <Map Locations="locations" IsPm10="isPm10" />
            }
            
        </div>
    </div>

</div>

<!-- 🔷 FLOATING TOGGLE -->
<div class="fixed bottom-10 right-6 z-[9999] group drop-shadow-2xl">

    <div class="absolute bottom-20 right-1/2 translate-x-1/2
        opacity-0 group-hover:opacity-100 transition
        bg-purple-500 text-white text-xs px-3 py-1 rounded shadow-lg whitespace-nowrap">
        Switch to @(isPm10 ? "PM2.5" : "PM10")
    </div>

    <button @onclick="TogglePm"
            class="relative w-20 h-20 rounded-full flex flex-col items-center justify-center
        shadow-2xl border border-white/30 backdrop-blur-md
        transition-all duration-300
        hover:scale-110 active:scale-95
        @(isPm10
                        ? "bg-gradient-to-br from-violet-400 via-purple-400 to-pink-400 text-white"
                        : "bg-gradient-to-br from-pink-400 via-purple-400 to-violet-400 text-white")">

        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-6 h-6 mb-1 transition-transform duration-300
            @(isPm10 ? "rotate-12 scale-110" : "")"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 15a4 4 0 014-4h1a5 5 0 0110 1h1a3 3 0 110 6H7a4 4 0 01-4-3z" />
        </svg>

        <span class="text-xs font-bold tracking-wide">
            @(isPm10 ? "PM10" : "PM2.5")
        </span>

    </button>

</div>



@code {

