@page "/dashboard"
@page "/"
@using ApexCharts
@using ParisarUI.Dashboard
@using ParisarUI.Pages.Shared

<div class="bg-gray-100 min-h-screen p-4">
   
      
       <!-- 🔷 FILTER SECTION -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border mb-4">
        <h2 class="text-sm font-semibold mb-3 text-gray-700">Filters</h2>

        <div class="flex flex-wrap gap-3 items-center">

            <select @bind="selectedOption" @bind:after="LoadStats"
                    class="border border-gray-300 p-2 rounded-lg w-48 text-xs shadow-sm">
                <option value="">Select Location</option>
                <option value="1">Alandi</option>
                <option value="2">Bhosari</option>
                <option value="3">Bhumkar Nagar</option>
                <option value="4">Hadapsar</option>
                <option value="5">Dhankawadi</option>
                <option value="6">MIT-Kothrud</option>
                <option value="7">Mhada Colony</option>
                <option value="8">Transport Nagar-Nigdi</option>
                <option value="9">Panchawati-Pashan</option>
                <option value="10">Savta Mali Nagar</option>
                <option value="11">Revenue Colony-Shivaji Nagar</option>
            </select>

            <InputDate @bind-Value="selectedDate"
                       class="border border-gray-300 p-2 rounded-lg text-xs shadow-sm" />

            <span class="text-xs">to</span>

            <InputDate @bind-Value="DateToday"
                       class="border border-gray-300 p-2 rounded-lg text-xs shadow-sm" />

            <button class="bg-blue-500 text-white px-4 py-2 rounded-lg text-xs shadow hover:bg-blue-600 transition">
                Update
            </button>
        </div>
    </div>

    <!-- 🔷 LOADER -->
    <Loader Visible="@isLoading"
            Text="Loading Air Quality Data..."
            Size="md" />

    <!-- 🔷 STATS -->
    @if (stats != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">

            <!-- CARD -->
            <div class="bg-white p-4 rounded-2xl shadow border text-center">
                <p class="text-xs text-gray-500">Total Days</p>
                <h3 class="text-xl font-bold text-blue-600">@stats.TotalDays</h3>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow border text-center">
                <p class="text-xs text-gray-500">Data Available</p>
                <h3 class="text-xl font-bold text-green-600">
                    @stats.DataAvailableDays
                </h3>
                <p class="text-[10px] text-gray-400">
                    @((stats.TotalDays == 0) ? 0 : (stats.DataAvailableDays * 100) / stats.TotalDays)%
                </p>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow border text-center">
                <p class="text-xs text-gray-500">Rank</p>
                <h3 class="text-xl font-bold text-purple-600">
                    @stats.Rank / @stats.TotalLocations
                </h3>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow border text-center">
                <p class="text-xs text-gray-500">Exceed Days</p>
                <h3 class="text-xl font-bold text-red-500">
                    @stats.ExceedDays
                </h3>
                <p class="text-[10px] text-gray-400">@stats.ExceedPercent%</p>
            </div>

        </div>
    }

    <!-- 🔷 CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

        <!-- BAR -->
        <div class="bg-white p-4 rounded-2xl shadow border">
            <h2 class="text-sm font-semibold mb-2 text-gray-700">
                Best vs Worst Areas (@(isPm10 ? "PM10" : "PM2.5"))
            </h2>

            <ApexChart TItem="ChartData" Options="barOptions" Height="250" @key="chartKey">
                <ApexCharts.ApexPointSeries TItem="ChartData"
                                            Items="(isPm10 ? barDataPM10 : barDataPM25)"
                                            SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.Area)"
                                            YValue="@(e => e.Value)" />
            </ApexChart>
        </div>

        <!-- LINE -->
        <div class="bg-white p-4 rounded-2xl shadow border">
            <h2 class="text-sm font-semibold mb-2 text-gray-700">
                Yearly Trends (@(isPm10 ? "PM10" : "PM2.5"))
            </h2>

            <ApexChart TItem="DataPoint" Height="250" @key="chartKey">

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="(isPm10 ? Data2024_PM10 : Data2024_PM25)"
                                            Name="2024"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="(isPm10 ? Data2025_PM10 : Data2025_PM25)"
                                            Name="2025"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />

                <ApexCharts.ApexPointSeries TItem="DataPoint"
                                            Items="(isPm10 ? Data2026_PM10 : Data2026_PM25)"
                                            Name="2026"
                                            SeriesType="SeriesType.Line"
                                            XValue="e => e.Month"
                                            YValue="e => e.Value" />
            </ApexChart>
        </div>

    </div>
</div>

