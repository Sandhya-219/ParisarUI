        isLoading = true;
        try
        {
            var locationRespone = await Http.GetFromJsonAsync<ApiResponse<Location>>("api/locations");

            if (locationRespone != null && locationRespone.Success)
            {
                locations = locationRespone.Data ?? new List<Location>();
            }
            await Task.WhenAll(
                        LoadChartData(),
                        LoadMonthlyTrend()
                        );

            //await LoadChartData();

            //await LoadMonthlyTrend(); //line chart
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
        
    }

    private void OnToggleChanged()
    {
        chartKey++; // 🔥 force chart refresh
