<!-- 🔷 PREMIUM FLOATING TOGGLE (TEAL THEME) -->
<div class="fixed bottom-6 right-6 z-50 group">

    <!-- TOOLTIP -->
    <div class="absolute bottom-20 right-1/2 translate-x-1/2
        opacity-0 group-hover:opacity-100 transition
        bg-emerald-600 text-white text-xs px-3 py-1 rounded shadow-lg whitespace-nowrap">
        Switch to @(isPm10 ? "PM2.5" : "PM10")
    </div>

    <!-- BUTTON -->
    <button @onclick="TogglePm"
            class="relative w-20 h-20 rounded-full flex flex-col items-center justify-center
        shadow-2xl border border-emerald-200
        transition-all duration-300
        hover:scale-110 active:scale-95
        animate-pulse-slow
        @(isPm10
                         ? "bg-gradient-to-br from-emerald-400 to-teal-600 text-white shadow-emerald-300/50"
                         : "bg-gradient-to-br from-teal-400 to-emerald-600 text-white shadow-teal-300/50")">

        <!-- ICON -->
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-6 h-6 mb-1 transition-transform duration-300
            @(isPm10 ? "rotate-12 scale-110" : "")"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 15a4 4 0 014-4h1a5 5 0 0110 1h1a3 3 0 110 6H7a4 4 0 01-4-3z" />
        </svg>

        <!-- TEXT -->
        <span class="text-xs font-bold tracking-wide">
            @(isPm10 ? "PM10" : "PM2.5")
        </span>

    </button>

</div>

