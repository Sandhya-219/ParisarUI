    public class ChartData
    {
        public string Area { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    public class DataPoint
    {
        public string Month { get; set; } = string.Empty;
        public decimal Value { get; set; }
    }

    private List<ChartData> barDataPM25 =
    [        
        new() { Area = "Bhumkar Nagar" }
       
    ];

    private List<ChartData> barDataPM10 =
    [
        new() { Area = "Bhumkar Nagar" }
    ];

    #region PM2.5 & PM10
    private async Task LoadMonthlyTrend()
    {
        try
        {
            var from = selectedDate.ToString("yyyy-MM-dd");
            var to = DateToday.ToString("yyyy-MM-dd");

            var url = $"api/Dashboard/monthlydata?fromDate={from}&toDate={to}";

            var response = await Http.GetFromJsonAsync<MonthlyTrendResponse>(url);

            if (response != null && response.Success && response.Data != null)
            {
                var grouped = response.Data
                    .GroupBy(x => x.Year)
                    .ToList();

                YearlyPM10.Clear();
                YearlyPM25.Clear();

                foreach (var yearGroup in grouped)
                {
                    YearlyPM10[yearGroup.Key] = yearGroup
                        .OrderBy(x => x.MonthNumber)
                        .Select(x => new DataPoint
                        {
                            Month = x.Month,
                            Value = Math.Round(x.PM10, 2)
                        }).ToList();

                    YearlyPM25[yearGroup.Key] = yearGroup
                        .OrderBy(x => x.MonthNumber)
                        .Select(x => new DataPoint
                        {
                            Month = x.Month,
                            Value = Math.Round(x.PM25, 2)
                        }).ToList();
                }

                chartKey++;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    #endregion

    private void TogglePm()
    {
        isPm10 = !isPm10;
        chartKey++; // refresh charts
    }

    #region barchart code
    private async Task LoadChartData()
    {
        try
        {
            var from = selectedDate.ToString("yyyy-MM-dd");
            var to = DateToday.ToString("yyyy-MM-dd");

            var url = $"api/Dashboard?fromDate={from}&toDate={to}";

            var response = await Http.GetFromJsonAsync<BarChartApiResponse<AirQualityChartResponse>>(url);

            if (response != null && response.Success && response.Data != null)
            {
                var data = response.Data;

                // PM10
                barDataPM10 = data.BestPM10
                    .Select((x, i) => new ChartData
                    {
                        Area = $"{x.LocationName}(Best_{i + 1})",
                        Value = Math.Round(x.PM10,2)
                    })
                    .Concat(
                        data.WorstPM10.Select((x, i) => new ChartData
                        {
                            Area = $"{x.LocationName}(Worst_{i + 1})",
                            Value = Math.Round(x.PM10,2)
                        })
                    )
                    .ToList();

                // PM2.5
                barDataPM25 = data.BestPM25
                    .Select((x, i) => new ChartData
                    {
                        Area = $"{x.LocationName}(Best_{i + 1})",
                        Value = Math.Round(x.PM25,2)
                    })
                    .Concat(
                        data.WorstPM25.Select((x, i) => new ChartData
                        {
                            Area = $"{x.LocationName}(Worst_{i + 1})",
                            Value = Math.Round(x.PM25,2)
                        })
                    )
                    .ToList();

                chartKey++;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    #endregion
}